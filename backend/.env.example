# Server Port (Render sets this automatically, default is 5000)
PORT=5000

# MongoDB Connection String (Use your MongoDB Atlas URI for cloud deployment)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/clubsphere?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/clubsphere

# Secret key for JWT authentication
JWT_SECRET=clubsphere123

# (Optional) System Administrator setup
SYSTEM_ADMIN_NAME="System Account Administrator"
SYSTEM_ADMIN_EMAIL=admin@college.edu
SYSTEM_ADMIN_PASSWORD=YourStrongPassword123!
